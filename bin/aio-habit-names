#!/usr/bin/env python3
import os
import sys

from Adafruit_IO import Client as RestClient
from Adafruit_IO import RequestError as RestRequestError


FEEDS = [
    ("habit 1", "habit-tracker.habit-1-name"),
    ("habit 2", "habit-tracker.habit-2-name"),
    ("habit 3", "habit-tracker.habit-3-name"),
    ("streak",  "habit-tracker.habit-tracker-streak-name"),
]


def die(msg: str, rc: int = 1) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(rc)


def main() -> int:
    username = os.environ.get("IO_USERNAME")
    key = os.environ.get("IO_KEY")

    if not username:
        die("IO_USERNAME is not set. Did you source .secrets?")
    if not key:
        die("IO_KEY is not set. Did you source .secrets?")

    aio = RestClient(username, key)

    for label, feed_key in FEEDS:
        try:
            data = aio.receive(feed_key)
        except RestRequestError as e:
            print(f"{label}: ERROR reading {feed_key}: {e}", file=sys.stderr)
            continue

        value = "" if data.value is None else str(data.value)

        # The pipe markers make leading/trailing spaces visible.
        print(f"{label}: |{value}|")
        print(f"  feed: {feed_key}")
        print(f"  repr: {value!r}")
        print(f"  len : {len(value)}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
